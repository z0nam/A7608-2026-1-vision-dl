      "source": [
        "def im_convert(tensor): # PyTorch Tensor 이미지를 imshow가 볼 수 있는 형태로 바꾸는 함수\n",
        "    image = tensor.clone().detach().cpu().numpy()\n",
        "    image = image.transpose(1, 2, 0)\n",
        "    image = image.clip(0, 1)\n",
        "    return image"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 75,
      "id": "9593431e",
      "metadata": {
        "id": "9593431e",
        "colab": {
