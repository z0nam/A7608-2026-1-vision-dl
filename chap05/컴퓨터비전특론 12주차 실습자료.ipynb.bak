        "resnet18 = models.resnet18(weights=models.ResNet18_Weights.DEFAULT)\n",
        "alexnet = models.alexnet(weights=models.AlexNet_Weights.DEFAULT)\n",
        "vgg16 = models.vgg16(weights=models.VGG16_Weights.DEFAULT)\n",
